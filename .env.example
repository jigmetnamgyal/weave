# Weave local development environment.
#
# Copy to .env and adjust as needed:  cp .env.example .env
#
# Every value here is a local development default. No real credential belongs
# in this file or in .env — .env is gitignored, .env.example is committed and
# must stay free of secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# Listen address for the Go control-plane API.
API_HTTP_ADDR=:8080

# ---------------------------------------------------------------------------
# Dependencies (required — the API refuses to start without these)
# ---------------------------------------------------------------------------

# The host ports below are offset from these services' usual defaults so the
# stack cannot collide with a PostgreSQL or Redis you already run locally.
DATABASE_URL=postgres://weave:weave@localhost:55432/weave?sslmode=disable
REDIS_URL=redis://localhost:56379/0
NATS_URL=nats://localhost:54222
TEMPORAL_HOST_PORT=localhost:57233

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# none   — no spans are exported (default)
# stdout — spans are pretty-printed to the API process stdout
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=weave-api

# ---------------------------------------------------------------------------
# Local infrastructure (consumed by infra/docker-compose.yml)
#
# These are development-only credentials for a container that is not reachable
# outside localhost. They are intentionally weak and intentionally committed.
# ---------------------------------------------------------------------------

POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave

# Offset from the services' usual default ports on purpose — see the note
# above and the header of infra/docker-compose.yml.
POSTGRES_PORT=55432
REDIS_PORT=56379
NATS_PORT=54222
NATS_MONITORING_PORT=58222
TEMPORAL_PORT=57233
TEMPORAL_UI_PORT=58233

# ---------------------------------------------------------------------------
# Web application
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put a secret
# behind this prefix.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
