# Weave local development environment.
#
# Copy to .env and adjust as needed:  cp .env.example .env
#
# Every value here is a local development default. No real credential belongs
# in this file or in .env — .env is gitignored, .env.example is committed and
# must stay free of secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development

# Listen address for the Go control-plane API.
API_HTTP_ADDR=:8080

# ---------------------------------------------------------------------------
# Dependencies (required — the API refuses to start without these)
# ---------------------------------------------------------------------------

# The host ports below are offset from these services' usual defaults so the
# stack cannot collide with a PostgreSQL or Redis you already run locally.
# Owner connection. Migrations and the readiness probe use this.
DATABASE_URL=postgres://weave:weave@localhost:55432/weave?sslmode=disable

# The connection the API serves requests on, as a role that does NOT own the
# tables — row-level security does not apply to an owner, so serving requests
# on DATABASE_URL would disable every policy without anything failing.
#
# The role is created by migration 00004; `make db-app-role` sets this
# password on it.
APP_DATABASE_URL=postgres://weave_app:weave_app@localhost:55432/weave?sslmode=disable
REDIS_URL=redis://localhost:56379/0
NATS_URL=nats://localhost:54222
TEMPORAL_HOST_PORT=localhost:57233

# Where the session worker serves liveness and readiness. It handles no
# product traffic; this is for the deployment system, which otherwise cannot
# tell a working worker from one that is running and unable to do anything.
#
# Since M5.2 the worker also reads REDIS_URL above and GITHUB_APP_ID and
# GITHUB_APP_PRIVATE_KEY_PATH below: the session workflow cuts each session's
# branch, which needs an installation token. It fails to start without them.
# It does not read the webhook secret or the slug.
WORKER_HEALTH_ADDR=:8090

# Where the event ingestor serves liveness and readiness. It reads
# APP_DATABASE_URL and NATS_URL above, and nothing else.
INGESTOR_HEALTH_ADDR=:8091

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# none   — no spans are exported (default)
# stdout — spans are pretty-printed to the API process stdout
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=weave-api

# ---------------------------------------------------------------------------
# Local infrastructure (consumed by infra/docker-compose.yml)
#
# These are development-only credentials for a container that is not reachable
# outside localhost. They are intentionally weak and intentionally committed.
# ---------------------------------------------------------------------------

POSTGRES_USER=weave
POSTGRES_PASSWORD=weave
POSTGRES_DB=weave

# Offset from the services' usual default ports on purpose — see the note
# above and the header of infra/docker-compose.yml.
POSTGRES_PORT=55432
REDIS_PORT=56379
NATS_PORT=54222
NATS_MONITORING_PORT=58222
TEMPORAL_PORT=57233
TEMPORAL_UI_PORT=58233

# ---------------------------------------------------------------------------
# Authentication (Clerk)
#
# Create a Clerk application at https://dashboard.clerk.com, enable GitHub as
# the only social connection, and copy the values below from its API Keys page.
# The placeholders let the stack start and the health probes pass; signing in
# requires real values.
#
# Which key goes where matters:
#   CLERK_ISSUER          the API needs it to know which tokens to trust and
#                         where to fetch public signing keys.
#   CLERK_SECRET_KEY      web application only. The Go API never sees it —
#                         verifying a signature needs only public keys.
#   NEXT_PUBLIC_CLERK_*   embedded in the browser bundle. The publishable key
#                         is designed to be public; nothing else may use this
#                         prefix.
# ---------------------------------------------------------------------------

# Your Clerk Frontend API URL, e.g. https://example-42.clerk.accounts.dev
CLERK_ISSUER=https://replace-me.clerk.accounts.dev

# Optional. Only set this if a Clerk JWT template sets an audience; Clerk's
# default session token carries none, and the issuer check already binds a
# token to your instance.
CLERK_JWT_AUDIENCE=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk sends users for sign-in, and where they land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---------------------------------------------------------------------------
# Web application
#
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never put a secret
# behind this prefix.
# ---------------------------------------------------------------------------

# Server-side only: the web application calls the API during render, so this
# deliberately has no NEXT_PUBLIC_ prefix and never reaches the browser.
API_BASE_URL=http://localhost:8080

# Where the web application is served from. Used to build invitation links,
# which the API cannot do because it does not know the browser-facing host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GitHub App (Unit M3.1)
#
# Created once by the account owner at Settings -> Developer settings ->
# GitHub Apps. See context/features-specs/07-github-app-installation.md for
# the exact settings, permissions and events.
#
# Every value here is server-side only. None of them may ever gain a
# NEXT_PUBLIC_ prefix: the App private key is the root credential for every
# installation, and the browser must never hold it.
# ---------------------------------------------------------------------------

# Numeric App ID, shown on the App's settings page.
GITHUB_APP_ID=000000

# The App's URL slug, used to build the install link:
# https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=replace-me

# No OAuth client credentials here on purpose. The App does not request
# user authorization during installation — GitHub makes that mutually
# exclusive with the setup URL, and the installation binding rests on our
# own single-use state token rather than on a GitHub identity. An unused
# client secret would be a credential we hold and never spend.

# Shared secret for webhook signatures. Deliveries are verified as HMAC
# SHA-256 over the raw body, compared in constant time, before parsing.
GITHUB_APP_WEBHOOK_SECRET=replace-me

# Where GitHub delivers webhooks in development. GitHub cannot reach
# localhost, so deliveries go to a public proxy channel (smee.io) and a
# local forwarder pipes them to /v1/github/webhook. Empty in production,
# where the API is reachable directly.
GITHUB_WEBHOOK_PROXY_URL=

# Path to the generated .pem private key, not the key itself. Keeping it a
# path means the key is never pasted into a file that tends to get shared,
# and *.pem is already gitignored.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
