{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=23.11.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace @weave/web",
    "build": "npm run build --workspace @weave/web",
    "start": "npm run start --workspace @weave/web",
    "lint": "npm run lint --workspace @weave/web",
    "typecheck": "npm run typecheck --workspace @weave/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
